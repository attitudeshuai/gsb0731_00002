# Copy this file to .env and adjust values. NEVER commit the real .env.

# MySQL root password for the metadata database
MYSQL_ROOT_PASSWORD=change-me-root

# AES key for encrypting target-database connection passwords.
# MUST be a Base64-encoded 16, 24 or 32-byte key (AES-128/192/256).
# Generate one, e.g.:  openssl rand -base64 32
APP_AES_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY

# Host port for the frontend (Nginx). Backend & MySQL are NOT exposed to the host.
FRONTEND_PORT=8081
