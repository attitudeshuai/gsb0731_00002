# ============================================================
# DB Manager - Environment Configuration
# Copy this file to .env and adjust values before deployment.
# ============================================================

# --- MySQL (Metadata Database) ---
MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=db_manager
MYSQL_USER=dbmanager
MYSQL_PASSWORD=dbmanager123
MYSQL_ROOT_PASSWORD=root123

# --- AES Encryption Key ---
# Must be a Base64-encoded 16/24/32-byte key (128/192/256 bits).
# Generate one with:
#   openssl rand -base64 32
# DO NOT use the default value in production.
AES_SECRET_KEY=MTIzNDU2Nzg5MDEyMzQ1Njc4OTAxMjM0NTY3ODkwMTI=

# --- CORS ---
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost

# --- Frontend Port ---
FRONTEND_PORT=80

# --- Query Timeouts ---
# Interactive SQL query timeout in seconds (max 600).
QUERY_TIMEOUT_SECONDS=30
# Default row cap for SELECT results.
QUERY_MAX_ROWS=1000
# Export query timeout in seconds.
EXPORT_TIMEOUT_SECONDS=600

# --- Target Database Connection Pool ---
# Socket read timeout in ms. Must be >= the longest query/export timeout
# (default 600000 = 10 min) to avoid disconnecting long-running queries.
TARGET_DB_SOCKET_TIMEOUT=600000
# TCP connect timeout in ms.
TARGET_DB_CONNECT_TIMEOUT=10000
# HikariCP pool sizes.
TARGET_POOL_MAX_SIZE=5
TARGET_POOL_MIN_IDLE=1
